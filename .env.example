# Скопируйте этот файл в .env и заполните своими значениями: cp .env.example .env
# Схема работы: WhatsApp через Zernio (вебхук /webhooks/zernio) или Meta Cloud
# API (/webhooks/meta), и/или Telegram (Bot API, /webhooks/telegram/<bot_id>).
# Ответы клиентам в 24-часовом окне WhatsApp бесплатны; платно только для
# шаблонных рассылок.
#
# В мультитенанте (папка clients/) один сервер обслуживает все транспорты
# одновременно: платформа задаётся у каждого клиента полем provider
# (wa | zernio | tg). MESSAGING_PROVIDER ниже выбирает single-tenant-транспорт
# и разрешает мультитенант (meta, zernio или telegram).

MESSAGING_PROVIDER=zernio

# --- Zernio (WhatsApp через Zernio API) ---
# Единственный транспорт WhatsApp по умолчанию. Ключ общий на всю команду
# Zernio (дашборд -> API keys), формат sk_<64 hex>.
ZERNIO_API_KEY=
# Секрет вебхука: задаётся вами при создании эндпоинта
# (POST /v1/webhooks/settings, поле secret на URL <PUBLIC_BASE_URL>/webhooks/zernio).
# Проверяется заголовок X-Zernio-Signature (hex HMAC-SHA256 сырого тела).
ZERNIO_WEBHOOK_SECRET=
# (необязательно) База API Zernio; по умолчанию https://zernio.com/api/v1
ZERNIO_BASE_URL=https://zernio.com/api/v1

# --- Meta WhatsApp Cloud API (альтернативный транспорт) ---
# Нужен, только если хотите provider: wa у клиентов или MESSAGING_PROVIDER=meta.
# Токен System User с правами whatsapp_business_messaging/management:
# Business Settings -> Users -> System users -> Add -> Generate token.
# В мультитенанте (clients/) это fallback-токен для клиентов, у которых
# access_token в yaml пустой (случай «все номера под партнёрством и одним токеном»).
WHATSAPP_ACCESS_TOKEN=
# (single-tenant) ID бизнес-номера отправителя (WhatsApp > API Setup в приложении Meta).
WHATSAPP_PHONE_NUMBER_ID=
# App Secret приложения (developers.facebook.com -> App settings -> Basic).
# В мультитенанте — один на всех клиентов (секрет вашего приложения).
META_APP_SECRET=
# Любая строка; та же вводится в поле Verify Token при привязке вебхука.
META_VERIFY_TOKEN=
# (необязательно) Версия Graph API, по умолчанию v21.0 (в проде используется v26.0).
META_GRAPH_VERSION=v26.0

# --- Telegram (Bot API) ---
# В мультитенанте токен у каждого клиента свой (clients/<bot_id>.yaml,
# provider: tg) — глобальные переменные ниже не нужны. Они — только для
# single-tenant режима (MESSAGING_PROVIDER=telegram).
# Токен бота от @BotFather (формат 123456789:AA…).
TELEGRAM_BOT_TOKEN=
# Секрет вебхука (любая строка) — проверяется в заголовке
# X-Telegram-Bot-Api-Secret-Token. В мультитенанте генерируется автоматически.
TELEGRAM_WEBHOOK_SECRET=

# --- Публичный адрес сервиса ---
# База для setWebhook Telegram-клиентов: https://ваш-домен
# При сохранении TG-клиента сервер сам привяжет <PUBLIC_BASE_URL>/webhooks/telegram/<bot_id>.
# Не задан -> вебхук придётся привязывать вручную (панель покажет адрес).
PUBLIC_BASE_URL=

# --- Номер владельца (только single-tenant) ---
# E.164, например +77770000000. В мультитенанте не применяется: номер
# владельца задаётся в yaml каждого клиента (owner_whatsapp_phone).
OWNER_WHATSAPP_NUMBER=

# --- LLM API (OpenAI-совместимый формат) ---
# Базовый URL: https://api.openai.com/v1 или любой OpenAI-совместимый провайдер.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Модель по умолчанию (можно переопределить в конфиге клиента -> llm.model)
LLM_MODEL=gpt-6-luna

# --- Конфиг клиента (single-tenant) ---
# Какой файл из config/ использовать. По умолчанию client_config.yaml.
# В мультитенанте (CLIENTS_DIR задан или папка clients/ с клиентами) не используется.
CLIENT_CONFIG=client_config.yaml

# --- Мультитенант ---
# Папка реестра клиентов: один yaml на клиента. Имя файла — ключ клиента:
# цифры у Meta (phone_number_id) и Telegram (id бота), произвольный slug у
# Zernio (accountId задаётся полем zernio_account_id внутри yaml).
# Не задана -> single-tenant (один клиент из CLIENT_CONFIG), если только
# папка clients/ не содержит хотя бы один клиентский yaml — тогда мультитенант
# включается автоматически. На Railway укажите путь примонтированного volume,
# например /data/clients.
CLIENTS_DIR=

# --- Админ-API и панель /admin (мультитенант) ---
# Токен полного доступа к управлению клиентами (clients/*.yaml) через
# /admin/clients и страницу /admin. Сгенерируйте длинный случайный:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Не хардкодится в коде — только переменная окружения. Пусто = админ-API
# и панель отключены (роуты не существуют).
ADMIN_TOKEN=

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# --- Сервер вебхука ---
# APP_HOST=0.0.0.0 — слушать все интерфейсы (обязательно в Docker/Railway/Render).
# APP_PORT — только для локального запуска (python main.py). На Railway
# порт задаёт платформа через переменную PORT — она имеет приоритет над APP_PORT.
APP_HOST=0.0.0.0
APP_PORT=8080

# Ключи провайдеров
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Для транскрибации аудио: ElevenLabs Scribe v2 (https://api.elevenlabs.io/v1/speech-to-text, scribe_v2)
# или OpenAI Whisper (https://api.openai.com/v1, whisper-1)
TRANSCRIBE_BASE_URL=https://api.elevenlabs.io/v1/speech-to-text
TRANSCRIBE_MODEL=scribe_v2
# Для Vision (фото): если не задано, используются LLM_API_URL / LLM_API_KEY / LLM_MODEL
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
# Папка хранения оригиналов файлов и срок хранения в днях
MEDIA_DIR=/data/clients/media
MEDIA_RETENTION_DAYS=30

