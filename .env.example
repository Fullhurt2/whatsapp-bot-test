# Скопируйте этот файл в .env и заполните своими значениями: cp .env.example .env

# --- Провайдер WhatsApp ---
# bird = Bird API (вебхук /webhooks/bird, нужен пополненный кошелёк Bird)
# meta = Meta WhatsApp Cloud API (вебхук /webhooks/meta) — ответы клиентам
# в 24-часовом окне бесплатны; платно только для шаблонных рассылок.
MESSAGING_PROVIDER=meta

# --- Meta WhatsApp Cloud API (провайдер "meta") ---
# Токен System User с правами whatsapp_business_messaging/management:
# Business Settings -> Users -> System users -> Add -> Generate token.
# В мультитенанте (clients/) это fallback-токен для клиентов, у которых
# access_token в yaml пустой (случай «все номера под партнёрством и одним токеном»).
WHATSAPP_ACCESS_TOKEN=
# (single-tenant) ID бизнес-номера отправителя (WhatsApp > API Setup в приложении Meta).
WHATSAPP_PHONE_NUMBER_ID=
# App Secret приложения (developers.facebook.com -> App settings -> Basic).
# В мультитенанте — один на всех клиентов (секрет вашего приложения).
META_APP_SECRET=
# Любая строка; та же вводится в поле Verify Token при привязке вебхука.
META_VERIFY_TOKEN=
# (необязательно) Версия Graph API, по умолчанию v21.0.
META_GRAPH_VERSION=v21.0

# --- Доступ к Bird (провайдер "bird") ---
# API-ключ workspace Bird (bk_eu1_... или bk_us1_...). Регион определяется
# префиксом ключа: eu1 -> https://eu1.platform.bird.com, us1 -> us1.platform.bird.com.
BIRD_API_KEY=

# Секрет вебхука (whsec_...) из дашборда Bird (Developers > Webhooks)
# или из ответа POST /v1/webhooks. Показывается один раз.
BIRD_WEBHOOK_SECRET=

# (необязательно) Явный URL Bird API. Пусто = выводится из префикса ключа.
BIRD_API_URL=

# --- Номера WhatsApp (формат E.164, например +77770000000) ---
# Бизнес-номер, с которого шлёт бот. Обязателен для провайдера bird
# (у Meta отправитель определяется WHATSAPP_PHONE_NUMBER_ID).
WHATSAPP_SENDER_NUMBER=

# Номер владельца для уведомлений [HANDOFF]; может задаваться и в yaml
# (owner_whatsapp_phone), значение из .env имеет приоритет.
# В мультитенанте не применяется: номер владельца задаётся в clients/<id>.yaml.
OWNER_WHATSAPP_NUMBER=

# --- LLM API (OpenAI-совместимый формат) ---
# Базовый URL: https://api.openai.com/v1 или любой OpenAI-совместимый провайдер.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Модель по умолчанию (можно переопределить в конфиге клиента -> llm.model)
LLM_MODEL=gpt-6-luna

# --- Конфиг клиента (single-tenant) ---
# Какой файл из config/ использовать. По умолчанию client_config.yaml.
# Расширение .yaml можно не писать: CLIENT_CONFIG=client_config_nails_atyrau
# В мультитенанте (CLIENTS_DIR задан или папка clients/ с клиентами) не используется.
CLIENT_CONFIG=client_config.yaml

# --- Мультитенант (Meta) ---
# Папка реестра клиентов: один yaml на клиента, имя файла = phone_number_id.
# Не задана -> single-tenant (один клиент из CLIENT_CONFIG), если только
# папка clients/ не содержит хотя бы один клиентский yaml — тогда мультитенант
# включается автоматически. Явно задайте CLIENTS_DIR=clients (или путь к
# примонтированному volume, например /data/clients), чтобы включить режим
# независимо от содержимого папки.
CLIENTS_DIR=

# --- Админ-API и панель /admin (мультитенант) ---
# Токен полного доступа к управлению клиентами (clients/*.yaml) через
# /admin/clients и страницу /admin. Сгенерируйте длинный случайный:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Не хардкодится в коде — только переменная окружения. Пусто = админ-API
# и панель отключены (роуты не существуют).
ADMIN_TOKEN=

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# --- Сервер вебхука ---
# APP_HOST=0.0.0.0 — слушать все интерфейсы (обязательно в Docker/Railway/Render).
# APP_PORT — только для локального запуска (python main.py). На Railway/Render
# порт задаёт платформа через переменную PORT — она имеет приоритет над APP_PORT.
APP_HOST=0.0.0.0
APP_PORT=8000
